<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Manage login access</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">
</head>
<body class="bg-dark text-white">
<main class="container py-4">
    <a class="btn btn-outline-light mb-4" href="/streamer/">Back to dashboard</a>
    <h1>Manage login access</h1>
    <p>Only detschn can change login access. Disabling an account also blocks its existing sessions.</p>
    <p>Admins can manage games, register accounts, and upload gallery photos. Streamers can use the dashboard and connections.</p>
    <div class="table-responsive">
        <table class="table table-dark align-middle">
            <thead><tr><th scope="col">Username</th><th scope="col">Role</th><th scope="col">Login</th><th scope="col">Action</th></tr></thead>
            <tbody>
            <% for (const user of users) { const owner = user.username === 'detschn'; const enabled = owner || user.login_enabled; %>
                <tr>
                    <th scope="row"><%= user.username %></th>
                    <td><%= owner ? 'admin' : user.user_role %></td>
                    <td><%= enabled ? 'Enabled' : 'Disabled' %></td>
                    <td>
                        <% if (owner) { %>Always enabled<% } else { %>
                            <form action="/streamer/login-access" method="post">
                                <input type="hidden" name="csrfToken" value="<%= csrfToken %>">
                                <input type="hidden" name="uuid" value="<%= user.uuid %>">
                                <input type="hidden" name="enabled" value="<%= enabled ? 'false' : 'true' %>">
                                <button class="btn <%= enabled ? 'btn-outline-warning' : 'btn-outline-success' %>" type="submit"><%= enabled ? 'Disable' : 'Enable' %> login for <%= user.username %></button>
                            </form>
                        <% } %>
                    </td>
                </tr>
            <% } %>
            </tbody>
        </table>
    </div>
</main>
</body>
</html>

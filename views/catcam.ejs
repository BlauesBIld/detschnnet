<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <title><%= settings?.title || 'Camera' %> · DetschnNet</title>
    <link rel="icon" href="/img/mage.png">
    <link rel="stylesheet" href="/catcam/assets/camera.css">
    <script src="/catcam/assets/camera.js" defer></script>
    <script src="/catcam/assets/motion.js" defer></script>
    <script src="/catcam/assets/discord.js" defer></script>
</head>
<body>
<div class="shell">
    <nav class="navigation" aria-label="Main navigation">
        <a class="brand" href="/">Detschn<span>Net</span></a>
        <div class="navigation-links"><a href="/streamer/">Dashboard</a><span class="admin-badge">Admin only</span></div>
    </nav>
    <main>
        <section class="watch-panel" aria-label="Live camera">
            <div class="player" id="player">
                <video id="video" playsinline muted controls hidden aria-label="Live cat camera"></video>
                <div class="placeholder" id="placeholder">
                    <svg class="camera-icon" viewBox="0 0 80 60" fill="none" aria-hidden="true"><rect x="8" y="12" width="44" height="36" rx="5" stroke="currentColor" stroke-width="3"/><path d="m52 23 19-10v34L52 37" stroke="currentColor" stroke-width="3" stroke-linejoin="round"/><circle cx="29" cy="30" r="9" stroke="currentColor" stroke-width="3"/></svg>
                    <h2 id="empty-title"><%= settings ? 'Camera ready' : 'Configure camera' %></h2>
                    <p id="empty-description"><%= settings ? 'Start live view to monitor the camera.' : 'Enter the camera connection details below.' %></p>
                </div>
                <span class="video-label" id="video-label" hidden><span></span>LIVE VIEW</span>
            </div>
            <div class="toolbar">
                <div class="connection" role="status" aria-live="polite"><span id="status-dot"></span><span id="status">Not connected</span></div>
                <div class="controls">
                    <label class="sr-only" for="view-quality">Viewing quality</label>
                    <select id="view-quality"><option value="high" <%= settings?.quality !== 'low' ? 'selected' : '' %>>High quality</option><option value="low" <%= settings?.quality === 'low' ? 'selected' : '' %>>Low bandwidth</option></select>
                    <button id="start" class="primary" <%= !settings || setupError ? 'disabled' : '' %>>Start live view</button>
                    <button id="reconnect" hidden>Reconnect</button>
                    <button id="fullscreen" aria-label="Open camera fullscreen">Fullscreen</button>
                </div>
            </div>
            <p id="stream-message" class="stream-message" role="alert"></p>
        </section>
        <div class="below-player">
            <div class="privacy-note"><span class="lock" aria-hidden="true">&#128274;</span><div><strong>Just for your admins</strong><p>The live view and camera settings require an active admin account.</p></div></div>
            <p class="quiet-note">Live view starts muted. Use the video controls for sound when available.</p>
        </div>
        <section class="motion-panel" aria-label="Motion monitoring">
            <div><h2>Motion monitoring</h2><p id="monitor-status" role="status" aria-live="polite">Connecting to monitoring service…</p>
                <p id="last-motion">No motion received in this session.</p><p>Keep Motion Detection enabled in the Tapo app.</p><p id="monitor-warning" class="stream-message" role="alert"></p></div>
            <div class="alert-controls"><button id="enable-notifications">Enable desktop alerts</button><button id="test-notification" hidden>Test alert</button>
                <small id="notification-help">Keep this page open to receive desktop alerts.</small></div>
        </section>
        <section class="settings-card discord-card" aria-labelledby="discord-title">
            <details>
                <summary><div><h2 id="discord-title">Discord alerts</h2></div><span class="settings-toggle" aria-hidden="true">+</span></summary>
                <div class="settings-content">
                    <p class="settings-help">Send “Motion detected on camera, please check” with a screenshot from the motion event to your Discord channel. Alerts run on the server even when this page is closed. Save changes before testing; the test includes a current camera screenshot.</p>
                    <form id="discord-settings">
                        <div class="form-grid">
                            <label>Discord notifications<select name="discordEnabled"><option value="false" <%= !settings?.discordEnabled ? 'selected' : '' %>>Disabled</option><option value="true" <%= settings?.discordEnabled ? 'selected' : '' %>>Enabled</option></select></label>
                            <label>Message cooldown (seconds)<input type="number" name="discordCooldownSeconds" value="<%= settings?.discordCooldownSeconds || 60 %>" min="15" max="3600" required></label>
                            <label class="webhook-field">Discord webhook URL<input type="password" name="discordWebhookUrl" maxlength="400" autocomplete="new-password" spellcheck="false" placeholder="<%= settings?.discordConfigured ? 'Webhook saved — leave blank to keep it' : 'https://discord.com/api/webhooks/…' %>"></label>
                        </div>
                        <label class="checkbox-label"><input type="checkbox" name="discordRemove">Remove the saved webhook and disable Discord alerts</label>
                        <p id="discord-configured" class="settings-help"><%= settings?.discordConfigured ? 'A webhook is saved securely. Its URL is never displayed.' : 'No webhook saved. Save the camera connection settings first if needed.' %></p>
                        <div class="discord-actions"><button class="primary" id="save-discord" <%= !settings || !storageReady || setupError ? 'disabled' : '' %>>Save Discord settings</button><button type="button" id="test-discord" <%= !settings?.discordConfigured ? 'disabled' : '' %>>Send test message</button></div>
                        <p id="discord-feedback" class="save-message" role="status" aria-live="polite"></p>
                    </form>
                    <p id="discord-delivery" class="settings-help" role="status" aria-live="polite"></p>
                </div>
            </details>
        </section>
        <section class="recordings-panel" aria-labelledby="recordings-title">
            <section class="disk-space" aria-labelledby="disk-space-title">
                <div class="disk-space-heading"><h2 id="disk-space-title">Available disk space</h2><span id="disk-space-summary" role="status" aria-live="polite">Checking disk space…</span></div>
                <progress id="disk-space-bar" max="100" value="0" aria-labelledby="disk-space-title" aria-describedby="disk-space-summary" hidden></progress>
                <p id="disk-space-help">Space on the disk used for recordings, shared with the rest of the server.</p>
            </section>
            <div class="recordings-heading"><div><h2 id="recordings-title">Motion recordings</h2><p>Clips include about 10 seconds before motion and 2 minutes afterward. Further motion extends the recording. Unflagged clips expire after 3 days.</p></div>
                <label class="sr-only" for="clip-filter">Recording filter</label><select id="clip-filter"><option value="all">All recordings</option><option value="flagged">Flagged</option></select></div>
            <p id="clip-feedback" role="status" aria-live="polite"></p>
            <div id="clip-list" class="clip-list"></div><p id="clips-empty">Loading recordings…</p>
            <button id="more-clips" hidden>Load older clips</button>
            <section id="clip-playback" class="clip-playback" aria-label="Recording playback" hidden>
                <div class="playback-heading"><h3 id="clip-title">Recording</h3><button id="close-clip">Close playback</button></div>
                <video id="clip-video" controls playsinline preload="metadata" aria-label="Recorded motion clip"></video>
                <div class="motion-timeline" id="motion-timeline" aria-label="Clip timeline with motion markers">
                    <input id="clip-seek" type="range" min="0" max="1000" value="0" aria-label="Seek recording"><div id="motion-markers"></div>
                </div>
                <div class="timeline-labels"><span id="clip-time">0:00 / 0:00</span><span><span class="motion-key"></span>Motion detected · select a red marker to jump to it</span></div>
                <div class="playback-actions"><button id="flag-current">Flag to keep</button><button id="delete-current" class="delete-button">Delete clip</button><a id="download-clip" download>Download MP4</a><span id="clip-expiry"></span></div>
            </section>
        </section>
        <section class="settings-card" aria-labelledby="settings-title">
            <details id="settings-details" <%= !settings || setupError ? 'open' : '' %>>
                <summary><div><span class="eyebrow">Your camera</span><h2 id="settings-title">Connection settings</h2></div><span class="settings-toggle" aria-hidden="true">+</span></summary>
                <div class="settings-content">
                    <p class="settings-help">Use the <strong>Camera Account</strong> from Tapo → Camera settings → Advanced settings, and the camera’s local IP address.</p>
                    <% if (!storageReady || setupError) { %>
                        <p class="notice" role="alert"><%= setupError || 'Server setup is needed before you can save settings. Configure the camera encryption key using docs/cat-camera.md.' %></p>
                    <% } %>
                    <form id="camera-settings" data-configured="<%= Boolean(settings) %>">
                        <input type="hidden" name="csrfToken" value="<%= csrfToken %>">
                        <div class="form-grid">
                            <label>Camera name<input name="title" value="<%= settings?.title || 'Camera' %>" maxlength="80" required autocomplete="off"></label>
                            <label>Default quality<select name="quality"><option value="high" <%= settings?.quality !== 'low' ? 'selected' : '' %>>High quality</option><option value="low" <%= settings?.quality === 'low' ? 'selected' : '' %>>Low bandwidth</option></select></label>
                            <label>Camera IP address<input name="host" value="<%= settings?.host || '' %>" placeholder="192.168.1.50" required autocomplete="off" inputmode="decimal"></label>
                            <label>RTSP port<input name="port" type="number" value="<%= settings?.port || 554 %>" min="1" max="65535" required></label>
                            <label>Camera username<input name="username" value="<%= settings?.username || '' %>" maxlength="64" required autocomplete="off" autocapitalize="none" spellcheck="false"></label>
                            <label>Camera password<input name="password" type="password" maxlength="128" autocomplete="new-password" <%= settings ? '' : 'required' %> placeholder="<%= settings ? 'Leave blank to keep saved password' : 'Your Tapo Camera Account password' %>"></label>
                            <label>Motion monitoring and recording<select name="motionEnabled"><option value="true" <%= settings?.motionEnabled !== false ? 'selected' : '' %>>Enabled</option><option value="false" <%= settings?.motionEnabled === false ? 'selected' : '' %>>Disabled</option></select></label>
                        </div>
                        <div class="form-footer"><p>Credentials are encrypted on the server. Your saved password is never displayed.</p><button class="primary" id="save" <%= !storageReady || setupError ? 'disabled' : '' %>>Save settings</button></div>
                        <p id="save-message" class="save-message" role="status" aria-live="polite"></p>
                    </form>
                </div>
            </details>
        </section>
    </main>
    <dialog id="delete-clip-dialog" aria-labelledby="delete-clip-title" aria-describedby="delete-clip-description">
        <h2 id="delete-clip-title">Delete recording?</h2><p id="delete-clip-description"></p>
        <div class="dialog-actions"><button id="cancel-delete" autofocus>Cancel</button><button id="confirm-delete" class="delete-button">Delete permanently</button></div>
    </dialog>
    <footer>Camera access and recordings are restricted to administrators.</footer>
</div>
</body>
</html>
